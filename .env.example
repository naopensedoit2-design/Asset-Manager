# ─── Database ────────────────────────────────────────────────
# Neon PostgreSQL connection string (or any PostgreSQL-compatible URL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── Cloudinary ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─── Admin Authentication ────────────────────────────────────
# bcrypt hash of the admin password. Generate with:
#   node -e "const b=require('bcrypt');b.hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH="$2b$12$..."

# ─── Session ─────────────────────────────────────────────────
# Strong random string for signing cookies
SESSION_SECRET="change_me_to_a_long_random_string"

# ─── WhatsApp ────────────────────────────────────────────────
# Phone number with country code, no spaces or symbols (e.g. 5554999999999)
WHATSAPP_NUMBER="5554999999999"

# ─── Gestão / agentes ────────────────────────────────────────
# Token que a Margot (n8n) usa em Authorization: Bearer <token> nas rotas /api/v1.
# Mínimo de 24 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_API_TOKEN=""

# Segredo da rotina diária (/api/cron/diario). A Vercel envia automaticamente
# Authorization: Bearer <CRON_SECRET> quando esta variável existe no projeto.
CRON_SECRET=""

# ─── Margot (chat do site em /orcamento/detalhado) ───────────
# Chave da API do Claude (console.anthropic.com). Sem ela, o chat mostra
# uma mensagem educada e o botão de WhatsApp.
ANTHROPIC_API_KEY=""
# Opcional: modelo usado pela Margot (padrão claude-sonnet-5-5).
MARGOT_MODEL=""
# Só para testes (em produção, deixe comentada): endereço da API do Claude, sem barra no final.
# Aponte para um simulador local para testar a Margot sem gastar chamadas. Não deixe a linha ativa
# com valor vazio: vazio quebra a chamada (o padrão só vale quando a variável não existe).
# ANTHROPIC_BASE_URL="https://api.anthropic.com"

# ─── Google Agenda (conta de serviço) ────────────────────────
# Conteúdo do arquivo JSON da conta de serviço (pode colar o JSON inteiro ou em base64).
GOOGLE_SERVICE_ACCOUNT_JSON=""
# ID da agenda compartilhada com a conta de serviço (o seu e-mail, para a agenda principal).
GOOGLE_CALENDAR_ID=""
# Só para testes (em produção, deixe comentadas): endereços da API do Google Agenda e do token OAuth.
# GOOGLE_API_BASE="https://www.googleapis.com/calendar/v3"
# GOOGLE_TOKEN_URL="https://oauth2.googleapis.com/token"
# Opcional: endereço do site para o link do painel dentro dos eventos (a Vercel já informa sozinha).
SITE_URL=""

# ─── WhatsApp da Margot (API oficial da Meta) ───────────────
# Passo a passo completo em docs/whatsapp.md. Sem estas variáveis, o site funciona
# normalmente e a aba Conversas mostra o que falta.
# Token permanente do "usuário do sistema" (business.facebook.com → Usuários do sistema).
WHATSAPP_TOKEN=""
# ID do número de telefone da Margot (não é o número em si). Pegue em Gerenciador do WhatsApp →
# Telefones → número da empresa → "Identificação do número de telefone". Cuidado: a Configuração da
# API do app pode mostrar um número +1 da Meta (de teste); ele não serve para clientes e a Meta
# recusa o envio por ele com o erro 131037 (falta nome de exibição aprovado).
WHATSAPP_PHONE_NUMBER_ID=""
# Chave secreta do app (Configurações do app → Básico). Confere a assinatura de cada webhook.
WHATSAPP_APP_SECRET=""
# Senha inventada por você; a mesma vai no campo "Token de verificação" do webhook na Meta.
WHATSAPP_VERIFY_TOKEN=""
# Recomendado: ID da conta do WhatsApp Business (para o botão "Assinar webhooks" em Regras).
WHATSAPP_WABA_ID=""
# Opcionais: nome e idioma do modelo de aviso ao Leonardo, versão da Graph API e espera
# antes de responder (junta mensagens seguidas).
WHATSAPP_OWNER_TEMPLATE="aviso_margot"
WHATSAPP_TEMPLATE_LANG="pt_BR"
WHATSAPP_GRAPH_VERSION="v25.0"
WHATSAPP_DEBOUNCE_MS="5000"
# Só para testes (em produção, deixe comentada): endereço da Graph API, para apontar a um simulador local.
# WHATSAPP_API_BASE="https://graph.facebook.com"

# ─── Áudio (opcional) ────────────────────────────────────────
# A API do Claude não ouve nem fala: áudios são transcritos e lidos por uma API compatível
# com a da OpenAI. Sem a chave, a Margot pede para a pessoa escrever.
VOICE_API_KEY=""
VOICE_API_BASE="https://api.openai.com/v1"
TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"
TTS_MODEL="gpt-4o-mini-tts"
TTS_VOICE="coral"
