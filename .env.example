# ─── Database ────────────────────────────────────────────────
# Neon PostgreSQL connection string (or any PostgreSQL-compatible URL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── Cloudinary ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─── Admin Authentication ────────────────────────────────────
# bcrypt hash of the admin password. Generate with:
#   node -e "const b=require('bcrypt');b.hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH="$2b$12$..."

# ─── Session ─────────────────────────────────────────────────
# Strong random string for signing cookies
SESSION_SECRET="change_me_to_a_long_random_string"

# ─── WhatsApp ────────────────────────────────────────────────
# Phone number with country code, no spaces or symbols (e.g. 5554999999999)
WHATSAPP_NUMBER="5554999999999"

# ─── Gestão / agentes ────────────────────────────────────────
# Token que a Margot (n8n) usa em Authorization: Bearer <token> nas rotas /api/v1.
# Mínimo de 24 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_API_TOKEN=""

# Segredo da rotina diária (/api/cron/diario). A Vercel envia automaticamente
# Authorization: Bearer <CRON_SECRET> quando esta variável existe no projeto.
CRON_SECRET=""

# ─── Margot (chat do site em /orcamento/detalhado) ───────────
# Chave da API do Claude (console.anthropic.com). Sem ela, o chat mostra
# uma mensagem educada e o botão de WhatsApp.
ANTHROPIC_API_KEY=""
# Opcional: modelo usado pela Margot (padrão claude-sonnet-5-5).
MARGOT_MODEL=""

# ─── Google Agenda (conta de serviço) ────────────────────────
# Conteúdo do arquivo JSON da conta de serviço (pode colar o JSON inteiro ou em base64).
GOOGLE_SERVICE_ACCOUNT_JSON=""
# ID da agenda compartilhada com a conta de serviço (o seu e-mail, para a agenda principal).
GOOGLE_CALENDAR_ID=""
# Opcional: endereço do site para o link do painel dentro dos eventos (a Vercel já informa sozinha).
SITE_URL=""
