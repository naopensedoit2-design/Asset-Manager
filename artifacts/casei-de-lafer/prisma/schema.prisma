generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model HeroImage {
  id        Int      @id @default(autoincrement())
  type      String
  url       String
  publicId  String   @default("")
  videoUrl  String   @default("")
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id        Int      @id @default(autoincrement())
  url       String
  publicId  String   @default("")
  alt       String   @default("")
  coupleTag String   @default("")
  location  String   @default("")
  createdAt DateTime @default(now())
}

model BlockedDate {
  id    Int      @id @default(autoincrement())
  date  DateTime
  label String   @default("Reservado")
}

model SiteConfig {
  id             Int      @id @default(autoincrement())
  whatsappNumber String   @default("")
  weddingCount   Int      @default(0)
  driverQuote    String   @default("")
  showCalendar   Boolean  @default(true)
  heroOpacity    Int      @default(60)
}

// ─── Gestão (Fase 1) ─────────────────────────────────────────
// Todos os modelos abaixo são aditivos. Valores em centavos.
// Datas de evento são "date" (sem hora) para não haver ambiguidade de fuso.

model Client {
  id         Int      @id @default(autoincrement())
  name       String
  phone      String   @unique // só dígitos, com DDI (ex.: 5554999999999)
  email      String   @default("")
  source     String   @default("outro") // instagram | indicacao | site | cerimonialista | outro
  referredBy String   @default("")
  notes      String   @default("")
  // Dados para o Termo Simplificado (pedidos ao fechar)
  legalName  String   @default("")
  document   String   @default("") // CPF ou passaporte
  address    String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]
}

model Order {
  id           Int            @id @default(autoincrement())
  clientId     Int
  client       Client         @relation(fields: [clientId], references: [id])
  eventDate    DateTime?      @db.Date
  eventTime    String         @default("")
  venue        String         @default("")
  city         String         @default("")
  serviceIds   Int[]          @default([])
  notes        String         @default("")
  status       String         @default("novo")
  lostReason   String         @default("")
  createdBy    String         @default("admin") // admin | margot
  duration     String         @default("") // ex.: "Até 3 horas no local"
  publicToken  String?        @unique // link privado da proposta e do termo
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  quotes       Quote[]
  reservations Reservation[]
  payments     Payment[]
  history      OrderHistory[]

  @@index([status])
  @@index([eventDate])
}

model Quote {
  id            Int       @id @default(autoincrement())
  orderId       Int
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items         Json      // [{ serviceId, name, priceCents }]
  discountCents Int       @default(0)
  totalCents    Int
  depositCents  Int
  validUntil    DateTime? @db.Date
  pdfUrl        String    @default("")
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
}

model Reservation {
  id            Int       @id @default(autoincrement())
  orderId       Int
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  date          DateTime  @db.Date
  // Igual a "date" enquanto a reserva está ativa; null quando liberada.
  // O índice único garante uma única reserva ativa por data.
  activeDate    DateTime? @unique @db.Date
  kind          String    @default("provisoria") // provisoria | confirmada
  expiresAt     DateTime?
  blockedDateId Int?
  googleEventId String?
  releasedAt    DateTime?
  createdAt     DateTime  @default(now())
}

model Payment {
  id          Int       @id @default(autoincrement())
  orderId     Int
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind        String    @default("sinal") // sinal | saldo | outro
  amountCents Int
  dueDate     DateTime? @db.Date
  status      String    @default("a_receber") // a_receber | recebido | atrasado | cancelado
  paidAt      DateTime?
  method      String    @default("pix")
  externalId  String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @default("")
  priceCents  Int
  isAddon     Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model OrderHistory {
  id         Int      @id @default(autoincrement())
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String   @default("")
  toStatus   String
  actor      String   @default("admin") // admin | margot | sistema
  note       String   @default("")
  createdAt  DateTime @default(now())
}

// ─── Financeiro ──────────────────────────────────────────────
model Expense {
  id          Int       @id @default(autoincrement())
  date        DateTime  @db.Date // data do gasto (ou do orçamento/serviço)
  description String
  category    String    @default("outros")
  supplier    String    @default("")
  amountCents Int
  status      String    @default("pago") // pago | a_pagar
  dueDate     DateTime? @db.Date
  paidAt      DateTime? @db.Date
  notes       String    @default("")
  orderId     Int? // gasto ligado a um evento específico (ex.: combustível de um casamento)
  createdBy   String    @default("admin")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([date])
  @@index([status])
}

// ─── Uso da IA (custo da Margot) ─────────────────────────────
model AiUsage {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  channel        String   @default("site") // site | whatsapp
  conversationId String   @default("")
  model          String
  inputTokens    Int
  outputTokens   Int
  costMicroUsd   Int // custo estimado em milionésimos de dólar

  @@index([createdAt])
}
